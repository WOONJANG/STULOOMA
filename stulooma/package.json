{
  "name": "stulooma",
  "productName": "STULOOMA",
  "version": "0.1.0",
  "private": true,
  "description": "Independent local 3D garment design studio",
  "author": "STULOOMA contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:assets": "tsx scripts/generate-assets.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "dev:desktop": "node scripts/dev-electron.mjs",
    "package:linux": "npm run build && electron-forge make --platform=linux --arch=x64",
    "package:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "test:desktop": "playwright test --config=playwright.electron.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "fflate": "0.8.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
